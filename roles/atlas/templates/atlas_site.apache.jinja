{% call server(atlas__acme_certificates[0].domains, http='forward', https='atlas') %}

        CustomLog /var/log/apache2/atlas-access.log "%t runtime: %T, return size: %B, %{plainsize}n, status: %>s, remote host: %h, completed: %X, query string: %U%q, referer: %{Referer}i, user agent: %{User-agent}i"

        DocumentRoot {{ atlas__basedir }}/site
        <Directory />
                Options FollowSymLinks
                AllowOverride None
        </Directory>
        <Directory "{{ atlas__basedir }}/site" >
                Options Indexes FollowSymLinks MultiViews
                AllowOverride None

                Require all granted
        </Directory>

        ProxyRequests Off
        RequestHeader set X-Forwarded-Proto "https"
        ProxyPass / http://localhost:{{ atlas__gunicorn_port }}/
        ProxyPassReverse / http://localhost:{{ atlas__gunicorn_port }}/
        ProxyPreserveHost On

        ErrorLog /var/log/apache2/atlas-error.log

{% endcall %}

